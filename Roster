name: Update NFL Rosters

on:
  schedule:
    # Runs automatically every Tuesday at 9:00 AM UTC (5:00 AM Eastern)
    - cron: "0 9 * * 2" 
  workflow_dispatch: # Allows you to click a button to run it manually

jobs:
  update-data:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
      
      - name: Setup R Environment
        uses: r-lib/actions/setup-r@v2
        with:
          r-version: 'release'
          
      - name: Install Packages
        run: Rscript -e 'install.packages(c("nflreadr", "readr"))'
          
      - name: Run R Script
        run: Rscript exec/update_officials.R
        
      - name: Auto-Commit Back to Repository
        uses: stefanzweifel/git-auto-commit-action@v5
        with:
          commit_message: "Auto-update live 2026 NFL rosters and officials"
          file_pattern: "data/*.csv"
